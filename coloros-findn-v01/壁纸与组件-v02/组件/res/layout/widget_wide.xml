<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:weightSum="100">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="52"
        android:paddingStart="14dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextClock
            android:id="@+id/time"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="@font/bigfish_tide"
            android:includeFontPadding="false"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="24sp"
            android:autoSizeMaxTextSize="51sp"
            android:autoSizeStepGranularity="1sp"
            android:shadowColor="#80213657"
            android:shadowRadius="2"
            android:shadowDx="0"
            android:shadowDy="1"
            android:textColor="#EBF9FF"
            android:textSize="48sp" />
        <TextClock
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:format12Hour="M月d日 EEE"
            android:format24Hour="M月d日 EEE"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#BDD6EE"
            android:textSize="12sp" />
        <LinearLayout
            android:id="@+id/weather_row"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/weather_shortcut" />
            <TextView
                android:id="@+id/weather_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/system_weather"
                android:textColor="#D6E9FA"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="48"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:contentDescription="@string/whale_character"
        android:scaleType="fitCenter"
        android:src="@drawable/whale_reef_peek" />
</LinearLayout>
