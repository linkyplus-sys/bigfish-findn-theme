<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.bigfish.findn.motion"
    android:versionCode="6"
    android:versionName="0.6">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />
    <application android:label="大肥鱼锁屏视频" android:icon="@drawable/bigfish_lock_video" android:allowBackup="false">
        <activity android:name=".PreviewActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".MotionWallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/motion_wallpaper" />
        </service>
    </application>
</manifest>
